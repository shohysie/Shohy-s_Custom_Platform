//写入SY#CPF0C.baf
//施展SY#LFX01移除可能存在的队友受等级修正导致豁免变化
IF
	!GlobalGT("SY#CASTONCE","LOCALS",0)
	TriggerOverride(Player2,GlobalGT("SY#LVFXD","LOCALS",0))
THEN
	RESPONSE #100
		ReallyForceSpellRES("SY#LFX01",Player2)
		Continue()
END

