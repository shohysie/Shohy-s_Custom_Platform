	GlobalGT("SY#SKILLHLA","GLOBAL",0)
	!GlobalGT("SY#SKILLRACE","GLOBAL",0)
	Allegiance(Myself,ENEMY)
	Detect([GOODCUTOFF])
	!GlobalTimerNotExpired("SY#LVFIXGAP","LOCALS")
	IsWeaponRanged(Myself)
	OR(2)
