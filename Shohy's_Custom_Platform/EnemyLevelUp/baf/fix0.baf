/////////////////
//施展高阶技能
/////////////////

//次数减半的控制
IF
	Global("SY#LVFXD","LOCALS",1)
	Global("SY#SKILLHLA","GLOBAL",1)
	Allegiance(Myself,ENEMY)
	Detect([GOODCUTOFF])
	!GlobalTimerNotExpired("SY#LVFIXGAP","LOCALS")
THEN
	RESPONSE #100
		SetGlobalTimer("SY#LVFIXGAP","LOCALS",36)
		ReallyForceSpellRes("SY#LFIH2",Myself)	//在1-5轮后移除SY#LFHXX
		ReallyForceSpellRes("SY#LFX03",Myself)	//免疫36秒SY#LFX00防止待机动作（由于需要待机中断攻击来强制启动脚本）
		Continue()
END
//施展高阶远程技能
//人族等正常施展
IF
	Global("SY#LVFXD","LOCALS",1)
	GlobalGT("SY#SKILLHLA","GLOBAL",0)
	!GlobalGT("SY#SKILLRACE","GLOBAL",0)
	Allegiance(Myself,ENEMY)
	Detect([GOODCUTOFF])
	!GlobalTimerNotExpired("SY#LVFIXGAP","LOCALS")
	IsWeaponRanged(Myself)
	OR(2)
		XPGT(Player1,2999999)
		LevelGT(Player1,19)
	!Race(Myself,ORC)
	!Race(Myself,GNOLL)
	!Race(Myself,HOBGOBLIN)
	!Race(Myself,KOBOLD)
	!Race(Myself,GOBLIN)
	!Race(Myself,BUGBEAR)
	OR(15)
		General(Myself,HUMANOID)
		General(Myself,UNDEAD)
		Race(Myself,DEMONIC)
		Race(Myself,VAMPIRE)
		Race(Myself,GIANT)
		Race(Myself,ELEMENTAL)
		Race(Myself,GENIE)
		Race(Myself,YUANTI)
		Race(Myself,SOLAR)
		Race(Myself,ANTISOLAR)
		Race(Myself,PLANATAR)
		Race(Myself,DARKPLANATAR)
		Race(Myself,LIZARDMAN)
		Race(Myself,SALAMANDER)
		Race(Myself,DRIDER)
THEN
	RESPONSE #100
		SetGlobalTimer("SY#LVFIXGAP","LOCALS",36)
		ReallyForceSpellRes("SY#LFIH0",Myself)	//使用远程高阶技能
		ReallyForceSpellRes("SY#LFX02",Myself)	//免疫600秒SY#LFX00防止待机动作（由于需要待机中断攻击来强制启动脚本）
		Continue()
	RESPONSE #30
		SetGlobalTimer("SY#LVFIXGAP","LOCALS",6)
		Continue()
END
//亚人族减半施展（弱鸡不施展高阶）
