IF
	Global("SY#LVFIX","GLOBAL",1)
	!GlobalGT("SY#LVFIXED","LOCALS",0)
	Allegiance(Myself,ENEMY)
	Detect([GOODCUTOFF])
	XPLT(Player1,4000)
THEN
	RESPONSE #100
		SetGlobal("SY#LVFIXED","LOCALS",1)
		Continue()
END

IF
	Global("SY#LVFIX","GLOBAL",1)
	!GlobalGT("SY#LVFIXED","LOCALS",0)
	Allegiance(Myself,ENEMY)
	Detect([GOODCUTOFF])
	XPLT(Player1,16000)
	OR(2)
		XPGT(Player1,3999)
		LevelGT(Player1,2)
THEN
	RESPONSE #100
		SetGlobal("SY#LVFIXED","LOCALS",1)
		ReallyForceSpellRes("SY#LFX03",Myself)	//LV3
		Continue()
END

