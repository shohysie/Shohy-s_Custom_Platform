		Continue()
	RESPONSE #100
		SetGlobalTimer("SY#LVFIXGAP","LOCALS",36)
		Continue()
	RESPONSE #60
		SetGlobalTimer("SY#LVFIXGAP","LOCALS",6)
		Continue()
END
