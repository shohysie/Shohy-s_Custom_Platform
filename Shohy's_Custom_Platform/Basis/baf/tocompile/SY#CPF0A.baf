//生物初始化脚本为SY#CPF0A，包含必要机能，勿改
//SOLO时，SY#CPF0A（鸟A）在某些地图不会产生，必须在主角身上附加每轮召唤新的SY#CPF0C（鸟C），种族为鸟，脚本同B
//SY#CPF0A（鸟A）在工作完成后消失，给主角施加法术SY#CPF0B，内容为遇敌每轮对自己施展SY#CPF0C（包括法术和eff）召唤SY#CPF0C（鸟C）
IF
	!Race(Myself,BIRD)
	OR(2)
		GlobalGT("SY#COUNT","LOCALS",5)
		GlobalTimerExpired("SY#CPF0T","GLOBAL")
THEN
	RESPONSE #100
		ReallyForceSpellRes("SY#CPF0B",Player1)
		DestroySelf()
END
//SY#CPF0A（鸟A）在功能关闭时消失，给主角施加法术SY#CPF0D移除SY#CPF0B避免召唤SY#CPF0C（鸟C）
IF
	!Race(Myself,BIRD)
	!GlobalGT("SY#CPF00","GLOBAL",0)
THEN
	RESPONSE #100
		ReallyForceSpellRes("SY#CPF0D",Player1)
		DestroySelf()
END
//SY#CPF0C（鸟C）工作完成或功能关闭或看到SY#CPF0A（鸟A）就直接消失，不影响主角身上的附加法术
IF
	Race(Myself,BIRD)
	OR(4)
		Exists("SY#CPF0A")
		!GlobalGT("SY#CPF00","GLOBAL",0)
		GlobalGT("SY#COUNT","LOCALS",5)
		GlobalTimerExpired("SY#TIMEC","LOCALS")
THEN
	RESPONSE #100
		DestroySelf()
END

//SY#CPF0A（鸟A）产生时，重置全局计时器，并给主角施加法术SY#CPF0D移除SY#CPF0B，避免正常地图召唤SY#CPF0C（鸟C）（鸟C不需要全局计时）
IF
	OnCreation()
	!Race(Myself,BIRD)
THEN
	RESPONSE #100
		ReallyForceSpellRes("SY#CPF0D",Player1)
		SetGlobalTimer("SY#CPF0T","GLOBAL",6)
		Continue()
END

//以防止意外，鸟C还是加个本地计时器
IF
	OnCreation()
	Race(Myself,BIRD)
THEN
	RESPONSE #100
		SetGlobalTimer("SY#TIMEC","LOCALS",6)
		Continue()
END

//跟随
IF
	OnScreen(Player1)
	!InMyArea(Player1)
THEN
	RESPONSE #100
		CreateCreatureObject("SY#CPF0A",Player1,0,0,0)
		DestroySelf()
END

IF
	OnScreen(Player2)
	!InMyArea(Player2)
	!OnScreen(Player1)
THEN
	RESPONSE #100
		CreateCreatureObject("SY#CPF0A",Player2,0,0,0)
		DestroySelf()
END

IF
	OnScreen(Player3)
	!InMyArea(Player3)
	!OnScreen(Player1)
	!OnScreen(Player2)
THEN
	RESPONSE #100
		CreateCreatureObject("SY#CPF0A",Player3,0,0,0)
		DestroySelf()
END

IF
	OnScreen(Player4)
	!InMyArea(Player4)
	!OnScreen(Player1)
	!OnScreen(Player2)
	!OnScreen(Player3)
THEN
	RESPONSE #100
		CreateCreatureObject("SY#CPF0A",Player4,0,0,0)
		DestroySelf()
END

IF
	OnScreen(Player5)
	!InMyArea(Player5)
	!OnScreen(Player1)
	!OnScreen(Player2)
	!OnScreen(Player3)
	!OnScreen(Player4)
THEN
	RESPONSE #100
		CreateCreatureObject("SY#CPF0A",Player5,0,0,0)
		DestroySelf()
END

IF
	OnScreen(Player6)
	!InMyArea(Player6)
	!OnScreen(Player1)
	!OnScreen(Player2)
	!OnScreen(Player3)
	!OnScreen(Player4)
	!OnScreen(Player5)
THEN
	RESPONSE #100
		CreateCreatureObject("SY#CPF0A",Player6,0,0,0)
		DestroySelf()
END

//SY#CPF0A（鸟A）在没有敌人时消失，重置全局计时，并给主角施加法术SY#CPF0B每轮召唤SY#CPF0C（鸟C）
IF
	!Race(Myself,BIRD)
	!Detect([EVILCUTOFF])
	CombatCounter(0)
THEN
	RESPONSE #100
		ReallyForceSpellRes("SY#CPF0B",Player1)
		SetGlobalTimer("SY#CPF0T","GLOBAL",0)
		DestroySelf()
END
//SY#CPF0C（鸟C）在没有敌人时消失，只重置全局计时，不影响主角身上的附加法术
IF
	Race(Myself,BIRD)
	!Detect([EVILCUTOFF])
	CombatCounter(0)
THEN
	RESPONSE #100
		SetGlobalTimer("SY#CPF0T","GLOBAL",0)
		DestroySelf()
END

