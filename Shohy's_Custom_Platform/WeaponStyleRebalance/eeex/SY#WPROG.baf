//根据对应武器熟练度，攻击时概率屏蔽武器细节效果
IF
	OR(2)
		Global("SY#WPROP","GLOBAL",1)
		Global("SY#WPROP","GLOBAL",2)
	GlobalGT("SY#WPPRFC","GLOBAL",0)
THEN
	RESPONSE #100
		SetGlobalTimer("SY#SECOND","LOCALS",1)
		ReallyForceSpellRES("SY#WPBLK",Myself)
		Continue()
END