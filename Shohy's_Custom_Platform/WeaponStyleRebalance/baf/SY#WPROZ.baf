//武器流派扣掉1星后，如果关闭会返还。单独召唤一只鸟来对话。批量加到SY#CPF0D.baf之后

//双武器2星且局部变量SY#WP2WS不为0，返还为3星
IF
	Global("SY#WPDCRSLT","GLOBAL",0)	//全局控制，保险起见写上
	Global("EXISTING","LOCALS",1)	//对话中执行完毕将EXISTING设为2即消失
	Global("PROFBACK","LOCALS",1)	//需要执行返还动作
	Proficiency(Player%n%,PROFICIENCY2WEAPON,2)
	!TriggerOverride(Player%n%,Global("SY#WP2WS","LOCALS",0))
THEN
	RESPONSE #100
		ReallyForceSpellRes("SY#WP2WU",Player%n%)	//设为3星并让局部变量SY#WP2WS变0
		DisplayStringHead(Player%n%,@117)	//提示返还
		SetGlobal("EXISTING","LOCALS",2)
		Continue()
END
//双武器1星且局部变量SY#WP2WS不为0，返还为2星
IF
	Global("SY#WPDCRSLT","GLOBAL",0)
	Global("EXISTING","LOCALS",1)
	Global("PROFBACK","LOCALS",1)
	Proficiency(Player%n%,PROFICIENCY2WEAPON,1)
	!TriggerOverride(Player%n%,Global("SY#WP2WS","LOCALS",0))
THEN
	RESPONSE #100
		ReallyForceSpellRes("SY#WP2WV",Player%n%)	//设为2星并让局部变量SY#WP2WS变0
		DisplayStringHead(Player%n%,@117)	//提示返还
		SetGlobal("EXISTING","LOCALS",2)
		Continue()
END

