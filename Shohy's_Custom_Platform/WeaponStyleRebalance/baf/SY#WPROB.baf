//武器流派调整，对Player1~6，每秒计数并生效一次。加入到SY#CPF0B.bcs
//必定安装，兼容武器流派可投入更多星数的扣星模式。选择加星模式时需要修改SY#CPF0B将下列内容中和SY#WPROX.baf一致的部分删除，并修改星数判断

//右手对鸟无效为双手武器
//双手武器攻击次数调整
IF
	GlobalGT("SY#WPROP","GLOBAL",0)
	!GlobalTimerNotExpired("SY#SECOND","LOCALS")
	!IsWeaponRanged(Player%n%)
	!TriggerOverride(Player%n%,WeaponEffectiveVs("SY#CPF0A",MAINHAND))
	Proficiency(Player%n%,PROFICIENCY2HANDED,1)
THEN
	RESPONSE #100
		ReallyForceSpellRes("SY#WPAR1",Player%n%)	//攻击次数+0.5
		Continue()
END

IF
	GlobalGT("SY#WPROP","GLOBAL",0)
	!GlobalTimerNotExpired("SY#SECOND","LOCALS")
	!IsWeaponRanged(Player%n%)
	!TriggerOverride(Player%n%,WeaponEffectiveVs("SY#CPF0A",MAINHAND))
	ProficiencyGT(Player%n%,PROFICIENCY2HANDED,1)
THEN
	RESPONSE #100
		ReallyForceSpellRes("SY#WPAR2",Player%n%)	//攻击次数+1
		Continue()
END

//双手武器额外伤害加成，不需要武器熟练度
IF
	GlobalGT("SY#WPROP","GLOBAL",0)
	!GlobalTimerNotExpired("SY#SECOND","LOCALS")
	!IsWeaponRanged(Player%n%)
	!TriggerOverride(Player%n%,WeaponEffectiveVs("SY#CPF0A",MAINHAND))
THEN
	RESPONSE #100
		ReallyForceSpellRes("SY#WP2HA",Player%n%)	//视力量加伤害，但不认识18/xx
		Continue()
END

IF
	GlobalGT("SY#WPROP","GLOBAL",0)
	!GlobalTimerNotExpired("SY#SECOND","LOCALS")
	!IsWeaponRanged(Player%n%)
	!TriggerOverride(Player%n%,WeaponEffectiveVs("SY#CPF0A",MAINHAND))
	CheckStat(Player%n%,18,STR)
	CheckStatGT(Player%n%,50,STREXTRA)
	CheckStatLT(Player%n%,91,STREXTRA)
THEN
	RESPONSE #100
		ReallyForceSpellRes("SY#WP2HB",Player%n%)	//多+1伤害
		Continue()
END

IF
	GlobalGT("SY#WPROP","GLOBAL",0)
	!GlobalTimerNotExpired("SY#SECOND","LOCALS")
	!IsWeaponRanged(Player%n%)
	!TriggerOverride(Player%n%,WeaponEffectiveVs("SY#CPF0A",MAINHAND))
	CheckStat(Player%n%,18,STR)
	CheckStatGT(Player%n%,90,STREXTRA)
THEN
	RESPONSE #100
		ReallyForceSpellRes("SY#WP2HC",Player%n%)	//多+2伤害
		Continue()
END

//左右手都对鸟有效为双武器
//减少伤害
IF
	GlobalGT("SY#WPROP","GLOBAL",0)
	!GlobalTimerNotExpired("SY#SECOND","LOCALS")
	!IsWeaponRanged(Player%n%)
	TriggerOverride(Player%n%,WeaponEffectiveVs("SY#CPF0A",MAINHAND))
	TriggerOverride(Player%n%,WeaponEffectiveVs("SY#CPF0A",OFFHAND))
	!ProficiencyGT(Player%n%,PROFICIENCY2WEAPON,0)
THEN
	RESPONSE #100
		ReallyForceSpellRes("SY#WP2W0",Player%n%)	//武器伤害-2
		Continue()
END

IF
	GlobalGT("SY#WPROP","GLOBAL",0)
	!GlobalTimerNotExpired("SY#SECOND","LOCALS")
	!IsWeaponRanged(Player%n%)
	TriggerOverride(Player%n%,WeaponEffectiveVs("SY#CPF0A",MAINHAND))
	TriggerOverride(Player%n%,WeaponEffectiveVs("SY#CPF0A",OFFHAND))
	Proficiency(Player%n%,PROFICIENCY2WEAPON,1)
THEN
	RESPONSE #100
		ReallyForceSpellRes("SY#WP2W1",Player%n%)	//武器伤害-2但AC+1有利
		Continue()
END

IF
	GlobalGT("SY#WPROP","GLOBAL",0)
	!GlobalTimerNotExpired("SY#SECOND","LOCALS")
	!IsWeaponRanged(Player%n%)
	TriggerOverride(Player%n%,WeaponEffectiveVs("SY#CPF0A",MAINHAND))
	TriggerOverride(Player%n%,WeaponEffectiveVs("SY#CPF0A",OFFHAND))
	Proficiency(Player%n%,PROFICIENCY2WEAPON,2)
THEN
	RESPONSE #100
		ReallyForceSpellRes("SY#WP2W2",Player%n%)	//武器伤害-1，AC+2有利
		Continue()
END

IF
	GlobalGT("SY#WPROP","GLOBAL",0)
	!GlobalTimerNotExpired("SY#SECOND","LOCALS")
	!IsWeaponRanged(Player%n%)
	TriggerOverride(Player%n%,WeaponEffectiveVs("SY#CPF0A",MAINHAND))
	TriggerOverride(Player%n%,WeaponEffectiveVs("SY#CPF0A",OFFHAND))
	ProficiencyGT(Player%n%,PROFICIENCY2WEAPON,2)
THEN
	RESPONSE #100
		ReallyForceSpellRes("SY#WP2W3",Player%n%)	//武器伤害不减，AC+2有利
		Continue()
END

//双武器必须投入五颗星才能不减攻击次数
IF
	GlobalGT("SY#WPROP","GLOBAL",0)
	!GlobalTimerNotExpired("SY#SECOND","LOCALS")
	!IsWeaponRanged(Player%n%)
	TriggerOverride(Player%n%,WeaponEffectiveVs("SY#CPF0A",MAINHAND))
	TriggerOverride(Player%n%,WeaponEffectiveVs("SY#CPF0A",OFFHAND))
	OR(2)
		!ProficiencyGT(Player%n%,PROFICIENCY2WEAPON,2)
		!TriggerOverride(Player%n%,GlobalGT("SY#WP2WS","LOCALS",1))
THEN
	RESPONSE #100
		ReallyForceSpellRes("SY#WPAR0",Player%n%)	//攻击次数-0.5
		Continue()
END

//右手对鸟有效同时左手有东西但对鸟无效/正装备盾牌是剑盾
//剑盾流特效可以在持有远程武器时施展（限飞刀投石索等。排除弓箭放到spl里了）
IF
	GlobalGT("SY#WPROP","GLOBAL",0)
	!GlobalTimerNotExpired("SY#SECOND","LOCALS")
	TriggerOverride(Player%n%,WeaponEffectiveVs("SY#CPF0A",MAINHAND))
	HasItemSlot(Player%n%,SLOT_SHIELD)
	!TriggerOverride(Player%n%,WeaponEffectiveVs("SY#CPF0A",OFFHAND))	
	Proficiency(Player%n%,PROFICIENCYSWORDANDSHIELD,1)
THEN
	RESPONSE #100
		ReallyForceSpellRes("SY#WPSDX",Player%n%)	//初次攻击命中+2，命中后自动移除此法术
		ReallyForceSpellRes("SY#WPSDP",Player%n%)	//近战AC+1有利
		Continue()
END

IF
	GlobalGT("SY#WPROP","GLOBAL",0)
	!GlobalTimerNotExpired("SY#SECOND","LOCALS")
	TriggerOverride(Player%n%,WeaponEffectiveVs("SY#CPF0A",MAINHAND))
	HasItemSlot(Player%n%,SLOT_SHIELD)
	!TriggerOverride(Player%n%,WeaponEffectiveVs("SY#CPF0A",OFFHAND))	
	ProficiencyGT(Player%n%,PROFICIENCYSWORDANDSHIELD,1)
THEN
	RESPONSE #100
		ReallyForceSpellRes("SY#WPSDX",Player%n%)	//初次攻击命中+2，命中后自动移除此法术
		ReallyForceSpellRes("SY#WPSDQ",Player%n%)	//近战AC+2有利
		Continue()
END

//为了避免盾击提示“相同的意外法术”，#232被设为每轮一次
IF
	GlobalGT("SY#WPROP","GLOBAL",0)
	!GlobalGT("SY#CASTONCE","LOCALS",0)
	!GlobalTimerNotExpired("SY#SECOND","LOCALS")
	//!HasItemCategory(Player%n%,BOW,TRUE)
	//!HasItemCategory(Player%n%,XBOW,TRUE)
	ModalStateObject(Player%n%,NONE)
	NotStateCheck(Player%n%,STATE_DISABLED)
	TriggerOverride(Player%n%,WeaponEffectiveVs("SY#CPF0A",MAINHAND))
	//HasItemCategory(Player%n%,SHIELD,TRUE)
	HasItemSlot(Player%n%,SLOT_SHIELD)
	!TriggerOverride(Player%n%,WeaponEffectiveVs("SY#CPF0A",OFFHAND))	
	Proficiency(Player%n%,PROFICIENCYSWORDANDSHIELD,1)
THEN
	RESPONSE #100
		ReallyForceSpellRes("SY#WPSDA",Player%n%)
		Continue()
END

IF
	GlobalGT("SY#WPROP","GLOBAL",0)
	!GlobalGT("SY#CASTONCE","LOCALS",0)
	!GlobalTimerNotExpired("SY#SECOND","LOCALS")
	//!HasItemCategory(Player%n%,BOW,TRUE)
	//!HasItemCategory(Player%n%,XBOW,TRUE)
	ModalStateObject(Player%n%,NONE)
	NotStateCheck(Player%n%,STATE_DISABLED)
	TriggerOverride(Player%n%,WeaponEffectiveVs("SY#CPF0A",MAINHAND))
	//HasItemCategory(Player%n%,SHIELD,TRUE)
	HasItemSlot(Player%n%,SLOT_SHIELD)
	!TriggerOverride(Player%n%,WeaponEffectiveVs("SY#CPF0A",OFFHAND))	
	ProficiencyGT(Player%n%,PROFICIENCYSWORDANDSHIELD,1)
THEN
	RESPONSE #100
		ReallyForceSpellRes("SY#WPSDB",Player%n%)
		Continue()
END

//右手对鸟有效且左手无物品是单手武器
//单手武器攻击次数和攻击效果调整
IF
	GlobalGT("SY#WPROP","GLOBAL",0)
	!GlobalTimerNotExpired("SY#SECOND","LOCALS")
	!Class(Player%n%,Monk)
	!IsWeaponRanged(Player%n%)
	TriggerOverride(Player%n%,WeaponEffectiveVs("SY#CPF0A",MAINHAND))
	!HasItemSlot(Player%n%,SLOT_SHIELD)
	Proficiency(Player%n%,PROFICIENCYSINGLEWEAPON,1)
THEN
	RESPONSE #100
		ReallyForceSpellRes("SY#WP1HA",Player%n%)
		Continue()
END

IF
	GlobalGT("SY#WPROP","GLOBAL",0)
	!GlobalTimerNotExpired("SY#SECOND","LOCALS")
	!Class(Player%n%,Monk)
	!IsWeaponRanged(Player%n%)
	TriggerOverride(Player%n%,WeaponEffectiveVs("SY#CPF0A",MAINHAND))
	!HasItemSlot(Player%n%,SLOT_SHIELD)
	ProficiencyGT(Player%n%,PROFICIENCYSINGLEWEAPON,1)
THEN
	RESPONSE #100
		ReallyForceSpellRes("SY#WPAR1",Player%n%)
		ReallyForceSpellRes("SY#WP1HB",Player%n%)
		Continue()
END
//单手武器在单对单战斗时获得AC和THAC0奖励
IF
	GlobalGT("SY#WPROP","GLOBAL",0)
	!GlobalTimerNotExpired("SY#SECOND","LOCALS")
	!IsWeaponRanged(Player%n%)
	TriggerOverride(Player%n%,WeaponEffectiveVs("SY#CPF0A",MAINHAND))
	!HasItemSlot(Player%n%,SLOT_SHIELD)
	Proficiency(Player%n%,PROFICIENCYSINGLEWEAPON,1)
	!TriggerOverride(Player%n%,Range(SecondNearestEnemyOf(Player%n%),4))
THEN
	RESPONSE #100
		ReallyForceSpellRes("SY#WP1H1",Player%n%)
		Continue()
END

IF
	GlobalGT("SY#WPROP","GLOBAL",0)
	!GlobalTimerNotExpired("SY#SECOND","LOCALS")
	!IsWeaponRanged(Player%n%)
	TriggerOverride(Player%n%,WeaponEffectiveVs("SY#CPF0A",MAINHAND))
	!HasItemSlot(Player%n%,SLOT_SHIELD)
	ProficiencyGT(Player%n%,PROFICIENCYSINGLEWEAPON,1)
	!TriggerOverride(Player%n%,Range(SecondNearestEnemyOf(Player%n%),4))
THEN
	RESPONSE #100
		ReallyForceSpellRes("SY#WP1H2",Player%n%)
		Continue()
END

//和尚
IF
	GlobalGT("SY#WPROP","GLOBAL",0)
	!GlobalTimerNotExpired("SY#SECOND","LOCALS")
	Class(Player%n%,Monk)
	!IsWeaponRanged(Player%n%)
	OR(2)
		HasWeaponEquiped(Player%n%)
		HasItemSlot(Player%n%,SLOT_SHIELD)
THEN
	RESPONSE #100
		ReallyForceSpellRes("SY#WP1HA",Player%n%)
		Continue()
END

IF
	GlobalGT("SY#WPROP","GLOBAL",0)
	!GlobalTimerNotExpired("SY#SECOND","LOCALS")
	Class(Player%n%,Monk)
	!HasWeaponEquiped(Player%n%)
	!HasItemSlot(Player%n%,SLOT_SHIELD)
THEN
	RESPONSE #100
		ReallyForceSpellRes("SY#WP1HB",Player%n%)
		Continue()
END
