//武器细节调整，对Player1~6，每秒计数并生效一次。加入到SY#CPF0B.bcs

//右手对鸟无效为双手武器
IF
	OR(2)
		Global("SY#WPROP","GLOBAL",1)
		Global("SY#WPROP","GLOBAL",2)
	!GlobalTimerNotExpired("SY#SECOND","LOCALS")
	!IsWeaponRanged(Player%n%)
	!TriggerOverride(Player%n%,WeaponEffectiveVs("SY#CPF0A",MAINHAND))
THEN
	RESPONSE #100
		SetGlobalTimer("SY#SECOND","LOCALS",1)
		ReallyForceSpellRes("SY#WD2HA",Player%n%)
		Continue()
END

//左右手都对鸟有效为双武器
IF
	OR(2)
		Global("SY#WPROP","GLOBAL",1)
		Global("SY#WPROP","GLOBAL",2)
	!GlobalTimerNotExpired("SY#SECOND","LOCALS")
	!IsWeaponRanged(Player%n%)
	TriggerOverride(Player%n%,WeaponEffectiveVs("SY#CPF0A",MAINHAND))
	TriggerOverride(Player%n%,WeaponEffectiveVs("SY#CPF0A",OFFHAND))
THEN
	RESPONSE #100
		SetGlobalTimer("SY#SECOND","LOCALS",1)
		ReallyForceSpellRes("SY#WD2WA",Player%n%)
		Continue()
END

//右手对鸟有效且左手无物品是单手武器
IF
	OR(2)
		Global("SY#WPROP","GLOBAL",1)
		Global("SY#WPROP","GLOBAL",2)
	!GlobalTimerNotExpired("SY#SECOND","LOCALS")
	!IsWeaponRanged(Player%n%)
	TriggerOverride(Player%n%,WeaponEffectiveVs("SY#CPF0A",MAINHAND))
	!HasItemSlot(Player%n%,SLOT_SHIELD)
THEN
	RESPONSE #100
		ReallyForceSpellRes("SY#WD1HA",Player%n%)
		Continue()
END

//右手对鸟有效同时左手有东西但对鸟无效/正装备盾牌是剑盾
IF
	OR(2)
		Global("SY#WPROP","GLOBAL",1)
		Global("SY#WPROP","GLOBAL",2)
	!GlobalTimerNotExpired("SY#SECOND","LOCALS")
	!IsWeaponRanged(Player%n%)
	TriggerOverride(Player%n%,WeaponEffectiveVs("SY#CPF0A",MAINHAND))
	//HasItemCategory(Player%n%,SHIELD,TRUE)
	HasItemSlot(Player%n%,SLOT_SHIELD)
	!TriggerOverride(Player%n%,WeaponEffectiveVs("SY#CPF0A",OFFHAND))
THEN
	RESPONSE #100
		ReallyForceSpellRes("SY#WDSDA",Player%n%)
		Continue()
END
