//正常单手武器2星
IF
	Global("SY#WPDCRSLT","GLOBAL",1)
	!GlobalGT("TAKESTAR","LOCALS",0)
	GlobalGT("SY#WPROP","GLOBAL",0)
	Proficiency(Player%n%,PROFICIENCYSINGLEWEAPON,2)
	TriggerOverride(Player%n%,Global("SY#WP1HS","LOCALS",0))
THEN
	RESPONSE #100
		ReallyForceSpellRes("SY#WP1HS",Player%n%)	//设为1星并让局部变量SY#WP1HS变1
		DisplayStringHead(Player%n%,@116)	//提示扣星
		SetGlobal("TAKESTAR","LOCALS",1)
		Continue()
END
