//武器流派达到2星3星时，对Player1~6，扣掉1星并给予标记，每只鸟只进行一次。加入到SY#CPF0D.bcs
//组件2扣星模式需安装，加星模式无视

//开局双武器3星的情况
IF
	Global("SY#WPDCRSLT","GLOBAL",1)	//扣星开启
	!GlobalGT("TAKESTAR","LOCALS",0)
	GlobalGT("SY#WPROP","GLOBAL",0)
	Proficiency(Player%n%,PROFICIENCY2WEAPON,3)
	TriggerOverride(Player%n%,Global("SY#WP2WS","LOCALS",0))
THEN
	RESPONSE #100
		ReallyForceSpellRes("SY#WP2WR",Player%n%)	//设为2星并让局部变量SY#WP2WS变1
		DisplayStringHead(Player%n%,@111)	//提示扣星
		SetGlobal("TAKESTAR","LOCALS",1)
		Continue()
END
//正常双武器2星
IF
	Global("SY#WPDCRSLT","GLOBAL",1)
	!GlobalGT("TAKESTAR","LOCALS",0)
	GlobalGT("SY#WPROP","GLOBAL",0)
	Proficiency(Player%n%,PROFICIENCY2WEAPON,2)
	TriggerOverride(Player%n%,Global("SY#WP2WS","LOCALS",0))
THEN
	RESPONSE #100
		ReallyForceSpellRes("SY#WP2WS",Player%n%)	//设为1星并让局部变量SY#WP2WS变1
		DisplayStringHead(Player%n%,@112)	//提示扣星
		SetGlobal("TAKESTAR","LOCALS",1)
		Continue()
END
//扣1星之后又加到3星
IF
	Global("SY#WPDCRSLT","GLOBAL",1)
	!GlobalGT("TAKESTAR","LOCALS",0)
	GlobalGT("SY#WPROP","GLOBAL",0)
	Proficiency(Player%n%,PROFICIENCY2WEAPON,3)
	TriggerOverride(Player%n%,Global("SY#WP2WS","LOCALS",1))
THEN
	RESPONSE #100
		ReallyForceSpellRes("SY#WP2WT",Player%n%)	//设为2星并让局部变量SY#WP2WS变2
		DisplayStringHead(Player%n%,@113)	//提示扣星
		SetGlobal("TAKESTAR","LOCALS",1)
		Continue()
END

