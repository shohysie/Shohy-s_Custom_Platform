//玩家和附近敌人的属性调整，以Player1~6为中心施展范围法术
/*
//SY#EXM0X/0Y修改施法等级，判断法师施展01，判断牧德圣游施展02，诗人术士施展03/01
//SY#EXM1X/1Y判断法师等：智力修正施法速度07
//SY#EXM2X判断武僧施展04修正AC，牧圣施展05修正超度，同样条件下10判断诗人魅力施展1A-1G范围战歌，20判断萨满感知施展2A-2G修正魂灵，30判断萨满魅力修正AC
//SY#EXM3X为感知的抗魔修正

相应属性达到13/15/17/19/21/23/25时，人物获得1/2/3/4/5/6/7点修正。
感知的额外修正：数值达到15/16/17/18时，人物对法术的豁免检定+1/2/3/4有利；数值达到19/20/21/22/23/24/25时，人物免疫命死术、恐吓术、魅惑人类、催眠术/人类定身术、衰弱射线、恐惧术/强力魅惑/心智控制、困惑术、情绪控制/混乱术、弱智术、怪物定身术/控制术/死亡术
*/
//施法等级修正
IF
	!GlobalGT("SY#CASTONCE","LOCALS",0)
	Global("SY#EXM0","GLOBAL",1)
THEN
	RESPONSE #100
		ReallyForceSpellRes("SY#EXM0X",Player1)
		ReallyForceSpellRes("SY#EXM0X",Player2)
		ReallyForceSpellRes("SY#EXM0X",Player3)
		ReallyForceSpellRes("SY#EXM0X",Player4)
		ReallyForceSpellRes("SY#EXM0X",Player5)
		ReallyForceSpellRes("SY#EXM0X",Player6)
		Continue()
END
//术士和诗人改成也由智力修正施法等级
IF
	!GlobalGT("SY#CASTONCE","LOCALS",0)
	Global("SY#EXM0","GLOBAL",2)
THEN
	RESPONSE #100
		ReallyForceSpellRes("SY#EXM0Y",Player1)
		ReallyForceSpellRes("SY#EXM0Y",Player2)
		ReallyForceSpellRes("SY#EXM0Y",Player3)
		ReallyForceSpellRes("SY#EXM0Y",Player4)
		ReallyForceSpellRes("SY#EXM0Y",Player5)
		ReallyForceSpellRes("SY#EXM0Y",Player6)
		Continue()
END
//施法速度修正
IF
	!GlobalGT("SY#CASTONCE","LOCALS",0)
	Global("SY#EXM1","GLOBAL",1)
THEN
	RESPONSE #100
		ReallyForceSpellRes("SY#EXM1X",Player1)
		ReallyForceSpellRes("SY#EXM1X",Player2)
		ReallyForceSpellRes("SY#EXM1X",Player3)
		ReallyForceSpellRes("SY#EXM1X",Player4)
		ReallyForceSpellRes("SY#EXM1X",Player5)
		ReallyForceSpellRes("SY#EXM1X",Player6)
		Continue()
END
//术士和诗人也吃智力修正施法速度
IF
	!GlobalGT("SY#CASTONCE","LOCALS",0)
	Global("SY#EXM1","GLOBAL",2)
THEN
	RESPONSE #100
		ReallyForceSpellRes("SY#EXM1Y",Player1)
		ReallyForceSpellRes("SY#EXM1Y",Player2)
		ReallyForceSpellRes("SY#EXM1Y",Player3)
		ReallyForceSpellRes("SY#EXM1Y",Player4)
		ReallyForceSpellRes("SY#EXM1Y",Player5)
		ReallyForceSpellRes("SY#EXM1Y",Player6)
		Continue()
END
//其它修正
IF
	!GlobalGT("SY#CASTONCE","LOCALS",0)
	GlobalGT("SY#EXM2","GLOBAL",0)
THEN
	RESPONSE #100
		ReallyForceSpellRes("SY#EXM2X",Player1)
		ReallyForceSpellRes("SY#EXM2X",Player2)
		ReallyForceSpellRes("SY#EXM2X",Player3)
		ReallyForceSpellRes("SY#EXM2X",Player4)
		ReallyForceSpellRes("SY#EXM2X",Player5)
		ReallyForceSpellRes("SY#EXM2X",Player6)
		Continue()
END
//感知的抗魔修正
IF
	!GlobalGT("SY#CASTONCE","LOCALS",0)
	GlobalGT("SY#EXM3","GLOBAL",0)
THEN
	RESPONSE #100
		ReallyForceSpellRes("SY#EXM3X",Player1)
		ReallyForceSpellRes("SY#EXM3X",Player2)
		ReallyForceSpellRes("SY#EXM3X",Player3)
		ReallyForceSpellRes("SY#EXM3X",Player4)
		ReallyForceSpellRes("SY#EXM3X",Player5)
		ReallyForceSpellRes("SY#EXM3X",Player6)
		Continue()
END

