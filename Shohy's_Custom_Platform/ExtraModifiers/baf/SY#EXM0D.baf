//唱歌跳舞属性额外调整，对Player1~6，加入到SY#WPROD.baf
//SY#EXM2变量，法术10判断诗人魅力施展1A-1G范围战歌，20判断萨满感知施展2A-2G修正魂灵，30判断萨满魅力修正AC
//诗人：唱歌时，魅力修正30呎内队员在对抗附魔系/咒法系/死灵系的法术时的豁免奖励
//萨满：跳舞时，魅力调整AC，感知修正所召唤灵魂的等级（每级获得命中、伤害、防御、豁免各1点奖励，实际等级数字可能未增加）
//单体法术，只对唱歌跳舞的人物施法一次，法术内部自行判断人物属性施展范围buff
IF
	GlobalGT("SY#EXM2","GLOBAL",0)
	!GlobalGT("SY#CASTONCE","LOCALS",0)
	Class(Player%n%,BARD_ALL)
	ModalStateObject(Player%n%,BATTLESONG)
THEN
	RESPONSE #100
		ReallyForceSpellRes("SY#EXM10",Player%n%)
		SetGlobal("SY#CASTONCE","LOCALS",1)
		Continue()
END

IF
	GlobalGT("SY#EXM2","GLOBAL",0)
	!GlobalGT("SY#CASTONCE","LOCALS",0)
	Class(Player%n%,SHAMAN)
	ModalStateObject(Player%n%,SHAMANDANCE)
THEN
	RESPONSE #100
		ReallyForceSpellRes("SY#EXM20",Player%n%)
		ReallyForceSpellRes("SY#EXM30",Player%n%)
		SetGlobal("SY#CASTONCE","LOCALS",1)
		Continue()
END
