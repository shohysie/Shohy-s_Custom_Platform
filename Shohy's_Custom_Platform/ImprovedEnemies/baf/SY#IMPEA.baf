//根据玩家经验和等级调整自身等级，可以添加到SY#CPF0A.bcs
//升级列表：战士等级的一半
//SY#CPFL0为等级修正1
//如果人物等级40但是经验被扣到0，需要按等级计算。即经验或人物等级满足要求

IF
	!GlobalGT("SY#LVADJUST","LOCALS",0)
	XPLT(Player1,8000)
THEN
	RESPONSE #100
		SetGlobal("SY#LVADJUST","LOCALS",1)
		ChangeStat(Myself,LEVEL,1,SET)	//LV1
		Continue()
END

IF
	!GlobalGT("SY#LVADJUST","LOCALS",0)
	OR(2)
		LevelGT(Player1,3)
		XPGT(Player1,7999)
	XPLT(Player1,32000)
THEN
	RESPONSE #100
		SetGlobal("SY#LVADJUST","LOCALS",1)
		ChangeStat(Myself,LEVEL,2,SET)	//LV2
		Continue()
END

