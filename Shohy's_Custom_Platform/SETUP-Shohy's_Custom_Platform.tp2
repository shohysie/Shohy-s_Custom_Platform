											~%MOD_FOLDER%/languages/english/extramodifiers.tra~
											~%MOD_FOLDER%/languages/english/improvedenemies.tra~
											~%MOD_FOLDER%/languages/english/weaponstylerebalance.tra~
											~%MOD_FOLDER%/languages/english/enemylevelup.tra~
											~%MOD_FOLDER%/languages/english/acthac0fix.tra~

LANGUAGE	~Simplified Chinese~ ~schinese~	~%MOD_FOLDER%/languages/schinese/basis.tra~
											~%MOD_FOLDER%/languages/schinese/extramodifiers.tra~
											~%MOD_FOLDER%/languages/schinese/improvedenemies.tra~
											~%MOD_FOLDER%/languages/schinese/weaponstylerebalance.tra~
											~%MOD_FOLDER%/languages/schinese/enemylevelup.tra~
											~%MOD_FOLDER%/languages/schinese/acthac0fix.tra~

LANGUAGE	~Francais~			~french~	~%MOD_FOLDER%/languages/french/basis.tra~
											~%MOD_FOLDER%/languages/french/extramodifiers.tra~
											~%MOD_FOLDER%/languages/french/improvedenemies.tra~
											~%MOD_FOLDER%/languages/french/weaponstylerebalance.tra~
											~%MOD_FOLDER%/languages/french/enemylevelup.tra~
											~%MOD_FOLDER%/languages/french/acthac0fix.tra~
									  
/* *********************全局有效平台******************* */

/*原理：
脚本SY#CPF00/SY#CPF00分别为随时有效/仅战斗中有效，加入到全局脚本中
产生隐形生物SY#CPF0A（生物A）承载脚本，以SY#CPF0T全局计时6秒
以下####内为全局有效机理，可以略过

#############################################################################################################################
	战斗中生效：
	战斗中主角身边每轮产生生物A（法师职业）
	生物A在每轮工作完成后消失，此时给主角施加法术SY#CPF0B，内容为遇敌每轮对自己施展SY#CPF0C（包括法术和eff）召唤SY#CPF0C（生物C）
	补充：法术SY#CPF0B添加内容免疫一轮SY#CPF0C，避免正常地图召唤生物C
	生物A产生时，重置全局计时器SY#CPF0T为6，并给主角施加法术SY#CPF0D移除SY#CPF0B，避免正常地图召唤生物C
	关闭所有功能时，生物A如果存在会消失，此时也给主角施加法术SY#CPF0D移除SY#CPF0B避免召唤生物C
	生物A安装时复制出生物C（复制时改变种族），两者使用完全相同的脚本，用种族进行区分
	生物C不看全局计时器SY#CPF0T，而是每秒用SY#SECOND计时提升SY#COUNT，SY#COUNT到6就完成工作消失
	生物C完成工作或发现功能关闭或看到生物A都是直接消失，不影响主角身上的附加法术
	战斗之外：
	施展任意法术，也会产生生物A，由于没在战斗中，会立刻消失
	“模块：智力、感知、魅力带来额外修正”把它改成施法进行调整之后再消失
#############################################################################################################################
使用此平台添加自定义效果的操作如下：

生物初始化脚本为SY#CPF0A，包含必要机能，勿改。

SY#CPF0B为生物每秒施法脚本。建议需要给队员添加的修正放这个脚本里。即判断!GlobalTimerNotExpired("SY#SECOND","LOCALS")再施法。

SY#CPF0C为生物每轮施法脚本（鸟只存在一轮所以仅需要施法一次，局部变量SY#CASTONCE变1表示施法完毕）。建议对队友以外的调整放在这里，让鸟对Player1~6施展范围法术对附近生物起效。
范围法术的投射可以使用SY#CPF00.pro，对50呎内所有生物有效，如果需要区分敌我建议使用#318、#326之类（因为鸟是中立生物）

SY#CPF0D为生物其它脚本，建议凡是不适合放SY#CPF0B和SY#CPF0C的修正都放这个脚本里。如果需要计时器和计数器建议使用现有的SY#SECOND、SY#CASTONCE之类，或自行添加

用于给玩家提供调整选项：
主角身上会添加特殊能力SY#CPF0Z，使用后召唤隐形生物SY#CPF0Z
隐形生物的对话SY#CPF0Z用于调整自定义的全局变量，脚本SY#CPF0Z作为补充调整手段。在脚本SY#CPF0B/C/D中根据全局变量施展相应法术。
添加对话的写法参考以下几个模块的.d文件。

主平台文件全在basis目录下，其它模块放在各自目录下即可。tra文件请自行添加路径和避免重复
*/





//#########################################################
//#########################################################
/* ******************全局调整平台，必装***************** */
//#########################################################
//#########################################################

BEGIN @1	//Shohy的全局自定义调整平台
REQUIRE_PREDICATE GAME_IS ~bgee bg2ee eet~ @8	//版本不对
REQUIRE_PREDICATE !MOD_IS_INSTALLED "SETUP-Shohy's_Weapon_Style_Rebalance.tp2" "0" @2	//已经安装了旧版

ADD_PROJECTILE ~%MOD_FOLDER%/basis/pro/SY#CPF00.pro~
//PRINT ~新增投射SY#CPF00序号为%SY#CPF00%~

COPY ~%MOD_FOLDER%/basis/cre~ ~override~
COPY_EXISTING ~SY#CPF0A.cre~ ~override/SY#CPF0C.cre~	//在全局脚本不启动时，主角身上附加每轮召唤的鸟以启动脚本
	WRITE_BYTE 0x272 170

COMPILE ~%MOD_FOLDER%/basis/dlg~

COMPILE ~%MOD_FOLDER%/basis/baf/tocompile~

COPY ~%MOD_FOLDER%/basis/bam~ ~override~

COPY ~%MOD_FOLDER%/basis/eff~ ~override~

COPY ~%MOD_FOLDER%/basis/spl/noname~ ~override~

COPY ~%MOD_FOLDER%/basis/spl/SY#CPF0Z.spl~ ~override~
SAY NAME1 @11

COPY_EXISTING ~CAMPAIGN.2da~ ~override~
	COUNT_2DA_ROWS 10 camprowmax	//至少10列column，row行数读入camprowmax
	PATCH_IF camprowmax > 1 BEGIN
		FOR (camprows = 1 ; camprows < camprowmax ; ++camprows) BEGIN
			READ_2DA_ENTRY camprows 1 10 campscript	//WORLDSCRIPT名称
			SET "%campscript%added" = 0
		END
		FOR (camprows = 1 ; camprows < camprowmax ; ++camprows) BEGIN
			READ_2DA_ENTRY camprows 1 10 campscript	//WORLDSCRIPT名称
			PATCH_IF "%campscript%added" = 0 BEGIN
				INNER_ACTION BEGIN
					EXTEND_TOP ~%campscript%.bcs~ ~%MOD_FOLDER%/basis/baf/SY#CPF00.baf~	//添加全局控制
				END
				SET "%campscript%added" = 1
			END
		END
	END
	PATCH_IF FILE_EXISTS_IN_GAME ~baldur.bcs~ BEGIN
		INNER_ACTION BEGIN
			EXTEND_TOP ~baldur.bcs~ ~%MOD_FOLDER%/basis/baf/SY#CPF00.baf~
		END
	END
	PATCH_IF FILE_EXISTS_IN_GAME ~baldur25.bcs~ BEGIN
		INNER_ACTION BEGIN
			EXTEND_TOP ~baldur25.bcs~ ~%MOD_FOLDER%/basis/baf/SY#CPF00.baf~
		END
	END
BUT_ONLY




//#########################################################
//#########################################################
/***********模块：智力、感知、魅力带来额外修正************/
//#########################################################
//#########################################################
/*
法师、牧师/德鲁伊/圣武士/游侠/萨满、术士/诗人：智力、感知、魅力/智力分别修正施法等级
圣武士和牧师：魅力修正超度等级
武僧：感知修正防御
相应属性达到13/15/17/19/21/23/25时，人物获得+1/+2/+3/+4/+5/+6/+7有利修正。属性低至7/6/5/4/3/2/1时，人物获得-1/-2/-3/-4/-5/-6/-7不利修正。
感知的额外修正：数值达到15/16/17/18时，人物对法术的豁免检定+1/+2/+3/+4有利；低至7/4/3/2/1时，人物对法术的豁免检定-1/-2/-3/-4/-6不利；数值达到19/20/21/22/23/24/25时，人物免疫命死术、恐吓术、魅惑人类、催眠术/人类定身术、衰弱射线、恐惧术/强力魅惑/心智控制、困惑术、情绪控制/混乱术、弱智术、怪物定身术/控制术/死亡术
*/
BEGIN @21	//智力/感知/魅力带来额外修正
REQUIRE_PREDICATE (IDS_OF_SYMBOL (~projectl~ ~SY#CPF00~)) > 0 @9

COPY ~%MOD_FOLDER%/ExtraModifiers/spl/noname~ ~override~
COPY ~%MOD_FOLDER%/ExtraModifiers/eff~ ~override~

//SY#EXM0X/0Y修改施法等级，判断法师施展01，判断牧德圣游施展02，诗人术士施展03/01
//SY#EXM1X/1Y判断法师等：智力修正施法速度07
//SY#EXM2X判断武僧施展04修正AC，牧圣施展05修正超度，同样条件下10判断诗人魅力施展1A-1G范围战歌，20判断萨满感知施展2A-2G修正魂灵，30判断萨满魅力修正AC
//SY#EXM3X为感知的抗魔修正

//进行范围调整的法术，使用投射SY#CPF00
OUTER_SET SY#CPF00 = IDS_OF_SYMBOL (~projectl~ ~SY#CPF00~) +1
COPY ~%MOD_FOLDER%/ExtraModifiers/spl/SY#EXM0X.spl~ ~override~ ~%MOD_FOLDER%/ExtraModifiers/spl/SY#EXM0Y.spl~ ~override~~%MOD_FOLDER%/ExtraModifiers/spl/SY#EXM1X.spl~ ~override~ ~%MOD_FOLDER%/ExtraModifiers/spl/SY#EXM1Y.spl~ ~override~ ~%MOD_FOLDER%/ExtraModifiers/spl/SY#EXM2X.spl~ ~override~ ~%MOD_FOLDER%/ExtraModifiers/spl/SY#EXM3X.spl~ ~override~
	WRITE_SHORT   0x98 ~%SY#CPF00%~

//施展法术，放在SY#CPF0C.bcs
EXTEND_BOTTOM ~SY#CPF0C.bcs~ ~%MOD_FOLDER%/ExtraModifiers/baf/SY#EXM0C.baf~

//唱歌跳舞带来的额外修正，需要用脚本判断施展，放在SY#CPF0D.bcs
COPY_EXISTING ~SY#CPF0D.bcs~ ~override~
	DECOMPILE_AND_PATCH BEGIN
		FOR (n=1;n<7;++n) BEGIN
			APPEND_FILE_EVALUATE ~%MOD_FOLDER%/ExtraModifiers/baf/SY#EXM0D.baf~
		END
	END
BUT_ONLY

//需要让鸟给予修正后再消失
COPY_EXISTING ~SY#CPF0A.bcs~ ~override~
	R_B_B ~%MOD_FOLDER%/ExtraModifiers/baf/later0.baf~ ~%MOD_FOLDER%/ExtraModifiers/baf/later1.baf~ ON_MISMATCH END
BUT_ONLY

//给鸟添加对话控制
COMPILE ~%MOD_FOLDER%/ExtraModifiers/dlg~


/* *************智力、感知、魅力额外修正补充模块：将提升施法等级的装备改为提升智力/感知************ */
BEGIN @22	//因为智力/感知/魅力带来的施法等级修正无法累加，将装备上的提升施法等级效果改为提升智力/感知。建议在物品MOD之后安装
REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~SY#EXM00.spl~ @23	//要先安装“智力、感知、魅力带来额外修正”

COPY_EXISTING_REGEXP GLOB ~.*\.itm~ ~override~
	SPRINT textori @57	//重量：xx
	SPRINT textwiz @58	//提升奥术施法等效果已经被修改为提升智力
	SPRINT textprs @59	//提升神术施法等效果已经被修改为提升感知
	PATCH_IF (SOURCE_SIZE > 0x71) BEGIN
		READ_SHORT 0x1c itemtype
		READ_LONG 0x6a effectoffset
		READ_SHORT 0x70 effectamount
		PATCH_IF (itemtype != 0) & (itemtype != 8) & (itemtype != 9) & (itemtype != 10) & (itemtype != 11) & (itemtype != 13) & (itemtype != 14) & (itemtype != 31) & (itemtype != 34) & (itemtype != 35) & (itemtype != 36) & (itemtype != 37) & (itemtype != 50) BEGIN
			PATCH_IF effectamount > 0 BEGIN
				FOR (effects = 1 ; effects < effectamount ; ++effects) BEGIN
					READ_SHORT (effectoffset + 0x30 * (effects - 1)) effecttype
					PATCH_IF effecttype == 191 BEGIN	//发现修改施法等级效果
						READ_LONG (8 + effectoffset + 0x30 * (effects - 1)) spllvtype
						READ_LONG 0x54 descref
						PATCH_IF spllvtype == 0 BEGIN	//是修改法师施法等级
							WRITE_SHORT (effectoffset + 0x30 * (effects - 1)) 19
							PATCH_IF (descref >= 0 && descref < 2147483646) BEGIN
								READ_STRREF 0x54 desc
								INNER_PATCH_SAVE newdesc ~%desc%~ BEGIN	//添加描述：提升施法等级改为提升智力
									REPLACE_TEXTUALLY ~%textori%~ ~%textwiz%~
								END
								INNER_ACTION BEGIN
									STRING_SET_EVALUATE descref ~%newdesc%~	//写入新描述
								END
							END
						END ELSE BEGIN	//是修改牧师施法等级
							WRITE_SHORT (effectoffset + 0x30 * (effects - 1)) 49
							WRITE_LONG (8 + effectoffset + 0x30 * (effects - 1)) 0
							PATCH_IF (descref >= 0 && descref < 2147483646) BEGIN
								READ_STRREF 0x54 desc
								INNER_PATCH_SAVE newdesc ~%desc%~ BEGIN	//添加描述：提升施法等级改为提升感知
									REPLACE_TEXTUALLY ~%textori%~ ~%textprs%~
								END
								INNER_ACTION BEGIN
									STRING_SET_EVALUATE descref ~%newdesc%~	//写入新描述
								END
							END
						END

					END
				END
			END
		END
	END
BUT_ONLY





//#########################################################
//#########################################################
/**************模块：增加敌人数值以提升难度***************/
//#########################################################
//#########################################################

BEGIN @61	//增加敌人数值以提升难度
REQUIRE_PREDICATE (IDS_OF_SYMBOL (~projectl~ ~SY#CPF00~)) > 0 @9

//进行范围调整的法术，使用投射SY#CPF00
OUTER_SET SY#CPF00 = IDS_OF_SYMBOL (~projectl~ ~SY#CPF00~) +1

//当HP过高时，#326调用SY#IMPE0来防止重复作用，再#318防护自身后继所有包括HP修正。HP上限为0x7FFF即32767，确保currentHP*(IMPEHP * headernum + 100)/100<30000
COPY ~%MOD_FOLDER%/ImprovedEnemies/spl/SY#IMPE1.spl~ ~override/SY#IMPE1.spl~
	WRITE_SHORT   0x98 ~%SY#CPF00%~
	//敌人数值少许提升
	SET IMPEHP = 10			//每等级增加IMPEHP%生命值
	SET IMPETHAC0 = 7		//每IMPETHAC0等级命中+1有利
	SET IMPEDAMAMGE = 1		//每等级增加IMPEDAMAMGE%伤害
	SET IMPEAC = 7			//每IMPEAC等级防御+1有利
	SET IMPESAVES = 10		//每IMPESAVES等级豁免+1有利
	SET IMPEMAGICRESIST = 4	//每IMPEMAGICRESIST等级魔抗+1%
	FOR (headernum = 1 ; headernum < 41 ; ++headernum) BEGIN
		PATCH_IF headernum != 1 BEGIN
			LPF ADD_SPELL_HEADER INT_VAR copy_header = 1 END
			LPF ALTER_SPELL_HEADER INT_VAR header = headernum min_level = headernum END
		END
		LPF ALTER_SPELL_EFFECT INT_VAR header = headernum match_opcode = 326 parameter1 = (3000000/(IMPEHP * headernum + 100)) END
		LPF ALTER_SPELL_EFFECT INT_VAR header = headernum match_opcode = 318 parameter1 = (3000000/(IMPEHP * headernum + 100)) STR_VAR resource = "SY#IMPE1" END
		LPF ALTER_SPELL_EFFECT INT_VAR header = headernum match_opcode = 18 timing = 0 duration = 600 parameter1 = (IMPEHP * headernum + 100) parameter2 = 2 END
		LPF ALTER_SPELL_EFFECT INT_VAR header = headernum match_opcode = 54 timing = 0 duration = 600 parameter1 = (headernum / IMPETHAC0) END
		LPF ALTER_SPELL_EFFECT INT_VAR header = headernum match_opcode = 332 timing = 0 duration = 600 parameter1 = (IMPEDAMAMGE * headernum) END
		LPF ALTER_SPELL_EFFECT INT_VAR header = headernum match_opcode = 0 timing = 0 duration = 600 parameter1 = (headernum / IMPEAC + 1) END
		LPF ALTER_SPELL_EFFECT INT_VAR header = headernum match_opcode = 325 timing = 0 duration = 600 parameter1 = (headernum / IMPESAVES) END
		LPF ALTER_SPELL_EFFECT INT_VAR header = headernum match_opcode = 166 timing = 0 duration = 600 parameter1 = (headernum / IMPEMAGICRESIST) END
	END
	LPF ADD_SPELL_EFFECT INT_VAR opcode = 18 target = 2 timing = 0 duration = 600 parameter1 = 15 END	//保底HP
	LPF ADD_SPELL_EFFECT INT_VAR opcode = 318 insert_point = 0 target = 2 duration = 1 parameter1 = 2 parameter2 = 102 STR_VAR resource = "SY#IMPE1" END	//友方生物不受影响
	LPF ADD_SPELL_EFFECT INT_VAR opcode = 318 insert_point = 0 target = 2 duration = 1 parameter1 = 3 parameter2 = 102 STR_VAR resource = "SY#IMPE1" END	//友方生物不受影响
	LPF ADD_SPELL_EFFECT INT_VAR opcode = 318 insert_point = 0 target = 2 duration = 1 parameter1 = 4 parameter2 = 102 STR_VAR resource = "SY#IMPE1" END	//友方生物不受影响
	LPF ADD_SPELL_EFFECT INT_VAR opcode = 318 insert_point = 0 target = 2 duration = 1 parameter1 = 5 parameter2 = 102 STR_VAR resource = "SY#IMPE1" END	//友方生物不受影响
	LPF ADD_SPELL_EFFECT INT_VAR opcode = 318 insert_point = 0 target = 2 duration = 1 parameter1 = 6 parameter2 = 102 STR_VAR resource = "SY#IMPE1" END	//魅惑生物不受影响
	LPF ADD_SPELL_EFFECT INT_VAR opcode = 318 insert_point = 0 target = 2 duration = 1 parameter1 = 254 parameter2 = 102 STR_VAR resource = "SY#IMPE1" END	//魅惑生物不受影响
	LPF ADD_SPELL_EFFECT INT_VAR opcode = 318 insert_point = 0 target = 2 duration = 1 parameter1 = 29 parameter2 = 102 STR_VAR resource = "SY#IMPE1" END	//中立生物不受影响
	LPF ADD_SPELL_EFFECT INT_VAR opcode = 318 insert_point = 0 target = 2 duration = 1 parameter1 = 128 parameter2 = 102 STR_VAR resource = "SY#IMPE1" END	//中立生物不受影响
	LPF ADD_SPELL_EFFECT INT_VAR opcode = 321 insert_point = 0 target = 2 timing = 1 STR_VAR resource = "SY#IMPE1" END
	LPF ADD_SPELL_EFFECT INT_VAR opcode = 321 insert_point = 0 target = 2 timing = 1 STR_VAR resource = "SY#IMPE2" END
	LPF ADD_SPELL_EFFECT INT_VAR opcode = 321 insert_point = 0 target = 2 timing = 1 STR_VAR resource = "SY#IMPE3" END
	LPF ADD_SPELL_EFFECT INT_VAR opcode = 206 target = 2 timing = 0 duration = 594 STR_VAR resource = "SY#IMPE1" END	//不会重复作用

COPY ~%MOD_FOLDER%/ImprovedEnemies/spl/SY#IMPE1.spl~ ~override/SY#IMPE2.spl~
	WRITE_SHORT   0x98 ~%SY#CPF00%~
	//敌人数值中等提升
	SET IMPEHP = 20			//每等级增加IMPEHP%生命值
	SET IMPETHAC0 = 5		//每IMPETHAC0等级命中+1有利
	SET IMPEDAMAMGE = 2		//每等级增加IMPEDAMAMGE%伤害
	SET IMPEAC = 5			//每IMPEAC等级防御+1有利
	SET IMPESAVES = 8		//每IMPESAVES等级豁免+1有利
	SET IMPEMAGICRESIST = 2	//每IMPEMAGICRESIST等级魔抗+1%
	FOR (headernum = 1 ; headernum < 41 ; ++headernum) BEGIN
		PATCH_IF headernum != 1 BEGIN
			LPF ADD_SPELL_HEADER INT_VAR copy_header = 1 END
			LPF ALTER_SPELL_HEADER INT_VAR header = headernum min_level = headernum END
		END
		LPF ALTER_SPELL_EFFECT INT_VAR header = headernum match_opcode = 326 parameter1 = (3000000/(IMPEHP * headernum + 100)) END
		LPF ALTER_SPELL_EFFECT INT_VAR header = headernum match_opcode = 318 parameter1 = (3000000/(IMPEHP * headernum + 100)) STR_VAR resource = "SY#IMPE2" END
		LPF ALTER_SPELL_EFFECT INT_VAR header = headernum match_opcode = 18 timing = 0 duration = 600 parameter1 = (IMPEHP * headernum + 100) parameter2 = 2 END
		LPF ALTER_SPELL_EFFECT INT_VAR header = headernum match_opcode = 54 timing = 0 duration = 600 parameter1 = (headernum / IMPETHAC0 + 1) END
		LPF ALTER_SPELL_EFFECT INT_VAR header = headernum match_opcode = 332 timing = 0 duration = 600 parameter1 = (IMPEDAMAMGE * headernum) END
		LPF ALTER_SPELL_EFFECT INT_VAR header = headernum match_opcode = 0 timing = 0 duration = 600 parameter1 = (headernum / IMPEAC + 1) END
		LPF ALTER_SPELL_EFFECT INT_VAR header = headernum match_opcode = 325 timing = 0 duration = 600 parameter1 = (headernum / IMPESAVES) END
		LPF ALTER_SPELL_EFFECT INT_VAR header = headernum match_opcode = 166 timing = 0 duration = 600 parameter1 = (headernum / IMPEMAGICRESIST) END
	END
	LPF ADD_SPELL_EFFECT INT_VAR opcode = 18 target = 2 timing = 0 duration = 600 parameter1 = 30 END	//保底HP
	LPF ADD_SPELL_EFFECT INT_VAR opcode = 318 insert_point = 0 target = 2 duration = 1 parameter1 = 2 parameter2 = 102 STR_VAR resource = "SY#IMPE2" END	//友方生物不受影响
	LPF ADD_SPELL_EFFECT INT_VAR opcode = 318 insert_point = 0 target = 2 duration = 1 parameter1 = 3 parameter2 = 102 STR_VAR resource = "SY#IMPE2" END	//友方生物不受影响
	LPF ADD_SPELL_EFFECT INT_VAR opcode = 318 insert_point = 0 target = 2 duration = 1 parameter1 = 4 parameter2 = 102 STR_VAR resource = "SY#IMPE2" END	//友方生物不受影响
	LPF ADD_SPELL_EFFECT INT_VAR opcode = 318 insert_point = 0 target = 2 duration = 1 parameter1 = 5 parameter2 = 102 STR_VAR resource = "SY#IMPE2" END	//友方生物不受影响
	LPF ADD_SPELL_EFFECT INT_VAR opcode = 318 insert_point = 0 target = 2 duration = 1 parameter1 = 6 parameter2 = 102 STR_VAR resource = "SY#IMPE2" END	//魅惑生物不受影响
	LPF ADD_SPELL_EFFECT INT_VAR opcode = 318 insert_point = 0 target = 2 duration = 1 parameter1 = 254 parameter2 = 102 STR_VAR resource = "SY#IMPE2" END	//魅惑生物不受影响
	LPF ADD_SPELL_EFFECT INT_VAR opcode = 318 insert_point = 0 target = 2 duration = 1 parameter1 = 29 parameter2 = 102 STR_VAR resource = "SY#IMPE2" END	//中立生物不受影响
	LPF ADD_SPELL_EFFECT INT_VAR opcode = 318 insert_point = 0 target = 2 duration = 1 parameter1 = 128 parameter2 = 102 STR_VAR resource = "SY#IMPE2" END	//中立生物不受影响
	LPF ADD_SPELL_EFFECT INT_VAR opcode = 321 insert_point = 0 target = 2 timing = 1 STR_VAR resource = "SY#IMPE1" END
	LPF ADD_SPELL_EFFECT INT_VAR opcode = 321 insert_point = 0 target = 2 timing = 1 STR_VAR resource = "SY#IMPE2" END
	LPF ADD_SPELL_EFFECT INT_VAR opcode = 321 insert_point = 0 target = 2 timing = 1 STR_VAR resource = "SY#IMPE3" END
	LPF ADD_SPELL_EFFECT INT_VAR opcode = 206 target = 2 timing = 0 duration = 594 STR_VAR resource = "SY#IMPE2" END	//不会重复作用

COPY ~%MOD_FOLDER%/ImprovedEnemies/spl/SY#IMPE1.spl~ ~override/SY#IMPE3.spl~
	WRITE_SHORT   0x98 ~%SY#CPF00%~
	//敌人数值大幅提升
	SET IMPEHP = 50			//每等级增加IMPEHP%生命值
	SET IMPETHAC0 = 3		//每IMPETHAC0等级命中+1有利
	SET IMPEDAMAMGE = 5		//每等级增加IMPEDAMAMGE%伤害
	SET IMPEAC = 3			//每IMPEAC等级防御+1有利
	SET IMPESAVES = 5		//每IMPESAVES等级豁免+1有利
	SET IMPEMAGICRESIST = 1	//每IMPEMAGICRESIST等级魔抗+1%
	FOR (headernum = 1 ; headernum < 41 ; ++headernum) BEGIN
		PATCH_IF headernum != 1 BEGIN
			LPF ADD_SPELL_HEADER INT_VAR copy_header = 1 END
			LPF ALTER_SPELL_HEADER INT_VAR header = headernum min_level = headernum END
		END
		LPF ALTER_SPELL_EFFECT INT_VAR header = headernum match_opcode = 326 parameter1 = (3000000/(IMPEHP * headernum + 100)) END
		LPF ALTER_SPELL_EFFECT INT_VAR header = headernum match_opcode = 318 parameter1 = (3000000/(IMPEHP * headernum + 100)) STR_VAR resource = "SY#IMPE3" END
		LPF ALTER_SPELL_EFFECT INT_VAR header = headernum match_opcode = 18 timing = 0 duration = 600 parameter1 = (IMPEHP * headernum + 100) parameter2 = 2 END
		LPF ALTER_SPELL_EFFECT INT_VAR header = headernum match_opcode = 54 timing = 0 duration = 600 parameter1 = (headernum / IMPETHAC0 + 1) END
		LPF ALTER_SPELL_EFFECT INT_VAR header = headernum match_opcode = 332 timing = 0 duration = 600 parameter1 = (IMPEDAMAMGE * headernum + 1) END
		LPF ALTER_SPELL_EFFECT INT_VAR header = headernum match_opcode = 0 timing = 0 duration = 600 parameter1 = (headernum / IMPEAC + 1) END
		LPF ALTER_SPELL_EFFECT INT_VAR header = headernum match_opcode = 325 timing = 0 duration = 600 parameter1 = (headernum / IMPESAVES) END
		LPF ALTER_SPELL_EFFECT INT_VAR header = headernum match_opcode = 166 timing = 0 duration = 600 parameter1 = (headernum / IMPEMAGICRESIST) END
	END
	LPF ADD_SPELL_EFFECT INT_VAR opcode = 18 target = 2 timing = 0 duration = 600 parameter1 = 75 END	//保底HP
	LPF ADD_SPELL_EFFECT INT_VAR opcode = 318 insert_point = 0 target = 2 duration = 1 parameter1 = 2 parameter2 = 102 STR_VAR resource = "SY#IMPE3" END	//友方生物不受影响
	LPF ADD_SPELL_EFFECT INT_VAR opcode = 318 insert_point = 0 target = 2 duration = 1 parameter1 = 3 parameter2 = 102 STR_VAR resource = "SY#IMPE3" END	//友方生物不受影响
	LPF ADD_SPELL_EFFECT INT_VAR opcode = 318 insert_point = 0 target = 2 duration = 1 parameter1 = 4 parameter2 = 102 STR_VAR resource = "SY#IMPE3" END	//友方生物不受影响
	LPF ADD_SPELL_EFFECT INT_VAR opcode = 318 insert_point = 0 target = 2 duration = 1 parameter1 = 5 parameter2 = 102 STR_VAR resource = "SY#IMPE3" END	//友方生物不受影响
	LPF ADD_SPELL_EFFECT INT_VAR opcode = 318 insert_point = 0 target = 2 duration = 1 parameter1 = 6 parameter2 = 102 STR_VAR resource = "SY#IMPE3" END	//魅惑生物不受影响
	LPF ADD_SPELL_EFFECT INT_VAR opcode = 318 insert_point = 0 target = 2 duration = 1 parameter1 = 254 parameter2 = 102 STR_VAR resource = "SY#IMPE3" END	//魅惑生物不受影响
	LPF ADD_SPELL_EFFECT INT_VAR opcode = 318 insert_point = 0 target = 2 duration = 1 parameter1 = 29 parameter2 = 102 STR_VAR resource = "SY#IMPE3" END	//中立生物不受影响
	LPF ADD_SPELL_EFFECT INT_VAR opcode = 318 insert_point = 0 target = 2 duration = 1 parameter1 = 128 parameter2 = 102 STR_VAR resource = "SY#IMPE3" END	//中立生物不受影响
	LPF ADD_SPELL_EFFECT INT_VAR opcode = 321 insert_point = 0 target = 2 timing = 1 STR_VAR resource = "SY#IMPE1" END
	LPF ADD_SPELL_EFFECT INT_VAR opcode = 321 insert_point = 0 target = 2 timing = 1 STR_VAR resource = "SY#IMPE2" END
	LPF ADD_SPELL_EFFECT INT_VAR opcode = 321 insert_point = 0 target = 2 timing = 1 STR_VAR resource = "SY#IMPE3" END
	LPF ADD_SPELL_EFFECT INT_VAR opcode = 206 target = 2 timing = 0 duration = 594 STR_VAR resource = "SY#IMPE3" END	//不会重复作用

COPY ~%MOD_FOLDER%/ImprovedEnemies/spl/noname~ ~override~
//给SY#CPF0A添加等级调整功能，鸟按主角经验对应战士等级的一半进行等级修正
