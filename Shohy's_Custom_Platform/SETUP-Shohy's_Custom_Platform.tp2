COPY ~%MOD_FOLDER%/WeaponStyleRebalance/spl/noname1~ ~override~

COPY ~%MOD_FOLDER%/WeaponStyleRebalance/wav/~ ~override~

//回旋斩共通部分
COPY ~%MOD_FOLDER%/WeaponStyleRebalance/spl/SY#WE1HL.spl~ ~override~	//单手回旋斩不让砍背后
WRITE_SHORT   0x98 ~%SY#WE1HL%~
//回旋斩区别部分
ACTION_IF howtodoeeex == 1 THEN BEGIN
	//有EEex，使用新版回旋斩	
	COPY ~%MOD_FOLDER%/WeaponStyleRebalance/eeex/SY#WE1HB.spl~ ~override~ ~%MOD_FOLDER%/WeaponStyleRebalance/eeex/SY#WE2HB.spl~ ~override~
	COPY ~%MOD_FOLDER%/WeaponStyleRebalance/eeex/SY#WE1HC.spl~ ~override~ ~%MOD_FOLDER%/WeaponStyleRebalance/eeex/SY#WE2HC.spl~ ~override~
	//仅回旋斩确定施展时显示文字，且只显示一次
	OUTER_SET slashstres = RESOLVE_STR_REF(@125)
	COPY_EXISTING ~M_SYATK.lua~ ~override~
		REPLACE_TEXTUALLY ~] = 11768,~ ~] = %slashstres%,~
	BUT_ONLY
	
	COPY ~%MOD_FOLDER%/WeaponStyleRebalance/eeex/SY#WE1HK.spl~ ~override~
		LPF ALTER_SPELL_HEADER INT_VAR header = 1 projectile = ~%SY#WE1HC%~ END
	//回旋斩不砍中立生物
		LPF ADD_SPELL_EFFECT INT_VAR opcode = 318 insert_point = 0 target = 2 duration = 1 parameter1 = 29 parameter2 = 102 STR_VAR resource = "SY#WE1HK" END
		LPF ADD_SPELL_EFFECT INT_VAR opcode = 318 insert_point = 0 target = 2 duration = 1 parameter1 = 128 parameter2 = 102 STR_VAR resource = "SY#WE1HK" END

	COPY ~%MOD_FOLDER%/WeaponStyleRebalance/eeex/SY#WE1HK.spl~ ~override/SY#WE2HK.spl~
		LPF ALTER_SPELL_HEADER INT_VAR header = 2 projectile = ~%SY#WE2HC%~ END
	//回旋斩不砍中立生物
		LPF ADD_SPELL_EFFECT INT_VAR opcode = 318 insert_point = 0 target = 2 duration = 1 parameter1 = 29 parameter2 = 102 STR_VAR resource = "SY#WE2HK" END
		LPF ADD_SPELL_EFFECT INT_VAR opcode = 318 insert_point = 0 target = 2 duration = 1 parameter1 = 128 parameter2 = 102 STR_VAR resource = "SY#WE2HK" END
	
END ELSE BEGIN
	//没有EEex，使用旧版回旋斩	
	COPY ~%MOD_FOLDER%/WeaponStyleRebalance/spl/SY#WE1HB.spl~ ~override~ ~%MOD_FOLDER%/WeaponStyleRebalance/spl/SY#WE2HB.spl~ ~override~
	COPY ~%MOD_FOLDER%/WeaponStyleRebalance/spl/SY#WE1HC.spl~ ~override~ ~%MOD_FOLDER%/WeaponStyleRebalance/spl/SY#WE2HC.spl~ ~override~
	
	COPY ~%MOD_FOLDER%/WeaponStyleRebalance/spl/SY#WE1HK.spl~ ~override~
		SAY NAME1 @125	//回旋斩
		LPF ALTER_SPELL_HEADER INT_VAR projectile = ~%SY#WE1HC%~ END
	//回旋斩不砍中立生物
		LPF ADD_SPELL_EFFECT INT_VAR opcode = 318 insert_point = 0 target = 2 duration = 1 parameter1 = 29 parameter2 = 102 STR_VAR resource = "SY#WE1HK" END
		LPF ADD_SPELL_EFFECT INT_VAR opcode = 318 insert_point = 0 target = 2 duration = 1 parameter1 = 128 parameter2 = 102 STR_VAR resource = "SY#WE1HK" END
	//双武时回旋斩要对其它技能加短暂限制
		LPF ADD_SPELL_EFFECT INT_VAR opcode = 318 target = 9 timing = 10 duration = 20 parameter1 = 32768 parameter2 = 138 STR_VAR resource = "SY#WM1HB" END
