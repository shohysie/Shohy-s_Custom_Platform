//#########################################################
//#########################################################
/*********************模块：武器流派平衡******************/
//#########################################################
//#########################################################
BEGIN @101
REQUIRE_PREDICATE (IDS_OF_SYMBOL (~projectl~ ~SY#CPF00~)) > 0 @9

ACTION_IF RESOURCE_CONTAINS ~ACTION.IDS~ ~EEex_LuaAction~ THEN BEGIN
	OUTER_WHILE NOT(IS_AN_INT %howtodoeeex%) || (%howtodoeeex% > 2) || (%howtodoeeex% < 1) BEGIN
		PRINT @10000	//检测到EEex存在。若安装适配EEex的特殊模块，可实现更多效果如副手多攻击一次，但不保证兼容性。输入1安装特殊模块，输入2正常安装：
		ACTION_READLN  howtodoeeex
	END
END ELSE BEGIN
	OUTER_SET howtodoeeex = 2
END

// ***武器流派平衡

//添加石肤和圣域的标记（镜影不用添加）
OUTER_SET "splprot_stonskins" = 0
COPY_EXISTING ~splprot.2da~ ~override~
	COUNT_2DA_ROWS 4 rows
	FOR ( index = 0 ; index < rows ; index = index + 1 ) BEGIN
		READ_2DA_ENTRY "%index%" 1 4 "splprot_stat"
		READ_2DA_ENTRY "%index%" 2 4 "splprot_value"
		READ_2DA_ENTRY "%index%" 3 4 "splprot_relation"
	  //PATCH_PRINT ~%index% %splprot_stat% %splprot_value% %splprot_relation%~
		PATCH_IF ("%splprot_stat%" STRING_COMPARE_CASE "88" = 0) & ("%splprot_value%" STRING_COMPARE_CASE "-1" = 0) & ("%splprot_relation%" STRING_COMPARE_CASE "4" = 0) BEGIN	//有现成的STONESKINS判断行
			SET "splprot_stonskins" = "%index%"
			SET "index" = "%rows%" + 1 // kills loop
		END
	END
	PATCH_IF (splprot_stonskins = 0) BEGIN
		SET "splprot_stonskins" = "%rows%"
		INSERT_2DA_ROW rows 4 ~%rows%_STONESKINS>=n                          88                                            -1                                            4~
	END
BUT_ONLY	//splprot_stonskins为splprot.2da新增STONESKINS判断行的编号

OUTER_SET "splprot_sanctuary" = 0
COPY_EXISTING ~splprot.2da~ ~override~
	COUNT_2DA_ROWS 4 rows
	FOR ( index = 0 ; index < rows ; index = index + 1 ) BEGIN
		READ_2DA_ENTRY "%index%" 1 4 "splprot_stat"
		READ_2DA_ENTRY "%index%" 2 4 "splprot_value"
		READ_2DA_ENTRY "%index%" 3 4 "splprot_relation"
	  //PATCH_PRINT ~%index% %splprot_stat% %splprot_value% %splprot_relation%~
		PATCH_IF ("%splprot_stat%" STRING_COMPARE_CASE "63" = 0) & ("%splprot_value%" STRING_COMPARE_CASE "1" = 0) & ("%splprot_relation%" STRING_COMPARE_CASE "4" = 0) BEGIN	//有现成的SANCTUARY判断行
			SET "splprot_sanctuary" = "%index%"
			SET "index" = "%rows%" + 1 // kills loop
		END
		PATCH_IF ("%splprot_stat%" STRING_COMPARE_CASE "63" = 0) & ("%splprot_value%" STRING_COMPARE_CASE "0" = 0) & ("%splprot_relation%" STRING_COMPARE_CASE "3" = 0) BEGIN	//有现成的SANCTUARY判断行
			SET "splprot_sanctuary" = "%index%"
			SET "index" = "%rows%" + 1 // kills loop
		END
		PATCH_IF ("%splprot_stat%" STRING_COMPARE_CASE "63" = 0) & ("%splprot_value%" STRING_COMPARE_CASE "1" = 0) & ("%splprot_relation%" STRING_COMPARE_CASE "1" = 0) BEGIN	//有现成的SANCTUARY判断行
			SET "splprot_sanctuary" = "%index%"
			SET "index" = "%rows%" + 1 // kills loop
		END
	END
	PATCH_IF (splprot_sanctuary = 0) BEGIN
		SET "splprot_sanctuary" = "%rows%"
		INSERT_2DA_ROW rows 4 ~%rows%_SANCTUARY=1                            63                                            1                                            1~
	END
BUT_ONLY	//splprot_sanctuary为splprot.2da新增STONESKINS判断行的编号

