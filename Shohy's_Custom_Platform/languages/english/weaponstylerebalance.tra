@101 = "Rebalance for Weapon Styles and Detailed Adjustments for Weapon Types"
@102 = "More proficiency slots can be spent on all Weapon Styles"
@103 = "(Recommended) Does not actually increase the rank limit, but automatically reduces one rank when reaching rank 2 or 3 in exchange for extra bonuses (Manually operable). No compatibility issues."
@104 = "Actually increases the proficiency rank limit, but not compatible with other MODs that alter Weapon Style rules. Must be installed after all Kit MODs."
@105 = "Requires 'Rebalance for Weapon Styles and Detailed Adjustments for Weapon Types' to be installed first."

@111 = "Weapon Style Rebalance: Two-Weapon Style reduces from rank 3 to 2, with numerical compensation already given. If raised to rank 3 again, it will be reduced once more. Can be turned off via protagonist's innate ability."
@112 = "Weapon Style Rebalance: Two-Weapon Style reduces from rank 2 to 1, with numerical compensation already given. Can then be raised normally to rank 2. Can be turned off via protagonist's innate ability."
@113 = "Weapon Style Rebalance: Two-Weapon Style reduces from rank 3 to 2, then can be raised normally to rank 3 and removes the attack per round penalty. Can be turned off via protagonist's innate ability."
@114 = "Weapon Style Rebalance: Two-Handed Weapon Style reduces from rank 2 to 1, with numerical compensation already given. Can then be raised normally to rank 2. Can be turned off via protagonist's innate ability."
@115 = "Weapon Style Rebalance: Sword and Shield Style reduces from rank 2 to 1, with numerical compensation already given. Can then be raised normally to rank 2. Can be turned off via protagonist's innate ability."
@116 = "Weapon Style Rebalance: Single-Weapon Style reduces from rank 2 to 1, with numerical compensation already given. Can then be raised normally to rank 2. Can be turned off via protagonist's innate ability."

