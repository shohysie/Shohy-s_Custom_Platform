@87 = "Keep current setting (enemies grant 50 Kill XP per level) and return to previous menu"
@88 = "Keep current setting (enemies grant 100 Kill XP per level) and return to previous menu"
@89 = "Keep current setting (enemies grant 200 Kill XP per level) and return to previous menu"
@90 = "Keep current setting (enemies grant 500 Kill XP per level) and return to previous menu"