@61 = "Enhanced Enemies (Enemy stats grow with protagonist XP)"
@62 = "Extra Kill XP granted to last attacker"

@65 = "Enemies' 'Enhancement Level' = (Level of a pure-class fighter with protagonist's XP) / 2.
After the protagonist accumulates 8 million XP, +1 'Enhancement Level' per 500k XP, capped at Lv40 at 18 million XP."
@66 = "Easy: for each 'Enhancement Level' the enemies gets 10% health and 1% of all damage; for every 4 'Enhancement Levels' the enemies gain 1 point of magic resistance; for every 7 'Enhancement Levels' they gain +1 bonus of AC and THAC0 ; for every 10 'Enhancement Levels' they gain +1 bonus to all saving throws.
For example: When the protagonist reaches 8 million XP, enemies gain 200% health, 20% all damage, 5% magic resistance, +2 bonus to AC and THAC0, and +2 bonus to all saving throws. "
@67 = "Normal: for each 'Enhancement Level' the enemies gets 20% health and 2% of all damage; for every 2 'Enhancement Levels' the enemies gain 1 point of magic resistance; for every 5 'Enhancement Levels' they gain +1 bonus of AC and THAC0 ; for every 8 'Enhancement Levels' they gain +1 bonus to all saving throws.
For example: When the protagonist reaches 8 million XP, enemies gain 400% health, 40% all damage, 10% magic resistance, +4 bonus to AC and THAC0, and +2 bonus to all saving throws. "
@68 = "Hard: for each 'Enhancement Level' the enemies gets 50% health and 5% of all damage; for every 'Enhancement Level' the enemies gain 1 point of magic resistance; for every 3 'Enhancement Levels' they gain +1 bonus of AC and THAC0 ; for every 5 'Enhancement Levels' they gain +1 bonus to all saving throws.
For example: When the protagonist reaches 8 million XP, enemies gain 1000% health, 100% all damage, 20% magic resistance, +6 bonus to AC and THAC0, and +4 bonus to all saving throws. "
@69 = "Enemies gain temporary enhancements during combat based on settings, lasting 10 minutes. After expiration, the enhancement is reapplied."

@70 = "Module function settings: Enhanced Enemies (enemy stats increase)"
@71 = "Module function settings: Enemy stats increase (lasts 10 minutes, reapplies after expiration)"
@72 = "Disable, enemies do not get stat increases"
@73 = "Easy, enemies get minor stat increases"
@74 = "Normal, enemies get moderate stat increases"
@75 = "Hard, enemies get large stat increases"
@76 = "Keep current setting (enemies do not get stat increases) and return to previous menu"
@77 = "Keep current setting (Easy) and return to previous menu"
@78 = "Keep current setting (Normal) and return to previous menu"
@79 = "Keep current setting (Hard) and return to previous menu"

@80 = "Module function settings: Kill XP granted to last attacker"
@81 = "Disable, enemies grant no bonus XP"
@82 = "Enemies grant 50 Kill XP per level"
@83 = "Enemies grant 100 Kill XP per level"
@84 = "Enemies grant 200 Kill XP per level"
@85 = "Enemies grant 500 Kill XP per level"
