@301 = "上调所有生物的AC和命中，以避免AC修正达到-20下限后失去意义"

@310 = "设置所有生物的AC和命中上调（建议AC达到下限时开启）"
@311 = "关闭调整"
@312 = "所有生物的AC和命中上调10点"
@313 = "所有生物的AC和命中上调20点"
@314 = "保留当前设置（关闭调整）并返回上一层选项"
@315 = "保留当前设置（上调10点）并返回上一层选项"
@316 = "保留当前设置（上调20点）并返回上一层选项"
@317 = "阅读所有生物的AC和命中上调的详细说明"
@318 = "越低的AC越不容易被打中，而越低的命中越容易打中人。游戏中AC修正有-20的下限，而命中修正没有下限。这会导致即使尽全力降低AC，在更低的命中面前也会失去意义。"
@319 = "如果将所有生物的AC和命中同时向上提升，就意味着AC获得了更多的向下修正空间。这对正常的游戏意义不大，但适合从各种MOD获得了更多堆AC手段的游戏版本。"
