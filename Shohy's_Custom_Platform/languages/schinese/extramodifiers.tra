@21 = "智力、感知、魅力带来额外修正"
@22 = "将装备上的提升施法等级效果改为提升智力/感知（因施法等级修正无法累加）。建议在物品MOD之后安装"
@23 = "需要先安装“智力、感知、魅力带来额外修正”"

@24 = "模块功能设置：智力、感知、魅力带来额外修正"
@25 = "设置智力、感知、魅力对施法等级的修正（会覆盖其它修改施法等级的效果）"
@26 = "设置智力的其它修正（模仿4e规则：修正法师的施法速度）"
@27 = "设置感知、魅力的其它修正（模仿3e规则：感知修正武僧的防御等级，魅力修正圣武士和牧师的超度等级、萨满跳舞时的AC、诗人的歌唱效果）"
@28 = "设置高感知的对抗法术奖励（模仿2e规则：高感知人物具备对法术的额外豁免，并可免疫部分精神类法术）"

@30 = "关闭施法等级修正"
@31 = "开启修正，并以魅力修正术士和吟游诗人的施法等级"
@32 = "开启修正，并以智力修正术士和吟游诗人的施法等级"
@33 = "保留当前设置（关闭施法等级修正）并返回上一层选项"
@34 = "保留当前设置（魅力修正术士和诗人施法等级）并返回上一层选项"
@35 = "保留当前设置（智力修正术士和诗人施法等级）并返回上一层选项"

@36 = "关闭智力对施法速度的修正"
@37 = "开启智力对施法速度的修正，仅限法师职业"
@38 = "开启智力对施法速度的修正，对法师、诗人和术士都有效"
@39 = "保留当前设置（智力不修正法师的施法速度）并返回上一层选项"
@40 = "保留当前设置（智力修正法师的施法速度）并返回上一层选项"
@41 = "保留当前设置（智力修正法师、诗人和术士的施法速度）并返回上一层选项"

@42 = "关闭感知、魅力对其它数值的修正"
@43 = "开启感知、魅力对其它数值的修正"
@44 = "保留当前设置（感知、魅力对其它数值没有修正）并返回上一层选项"
@45 = "保留当前设置（感知、魅力对其它数值有修正）并返回上一层选项"

@46 = "关闭高感知的对抗法术奖励"
@47 = "开启高感知的对抗法术奖励"
@48 = "保留当前设置（高感知没有对抗法术奖励）并返回上一层选项"
@49 = "保留当前设置（高感知有对抗法术奖励）并返回上一层选项"

@50 = "由于法术DC调整难以实现，现在使用法师施法等级和施法速度调整加以代替。"
@51 = "智力修正法师施法等级，感知修正牧师、德鲁伊、圣武士、游侠、萨满的施法等级，魅力修正术士和吟游诗人的施法等级（可选择以智力修正）。"
@52 = "感知修正武僧的防御等级；魅力修正圣武士和牧师的超度等级，还会给正在跳舞的萨满带来额外的AC修正、给诗人的歌曲添加对咒法系、附魔系和死灵系法术的豁免修正。"
@53 = "以上修正和对应属性值的关系：当属性达到13/15/17/19/21/23/25时，人物分别获得1/2/3/4/5/6/7点修正；当属性低至7/6/5/4/3/2/1时，人物分别获得-1/-2/-3/-4/-5/-6/-7点修正。"
@54 = "智力修正法师的施法速度：当属性达到18/20/22/24时，人物分别获得1/2/3/4点施法速度修正。"
@55 = "感知修正所有人对抗法术的能力。感知数值达到15/16/17/18时，人物对法术的豁免检定+1/2/3/4有利；感知数值低至7/4/3/2/1时，人物对法术的豁免检定分别-1/-2/-3/-4/-6不利。"
@56 = "感知达到19/20/21/22/23/24/25时，人物免疫命死术、恐吓术、魅惑人类、催眠术/人类定身术、衰弱射线、恐惧术/强力魅惑/心智控制、困惑术、情绪控制/混乱术、弱智术、怪物定身术/控制术/死亡术。"

