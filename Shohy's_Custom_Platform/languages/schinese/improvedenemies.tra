@61 = "难度加强（敌人数值提升）"
@62 = "敌人死亡时给予最后攻击者一定经验"

@65 = "如果把主角的经验点数让一个专职战士拥有，则这个战士等级的一半为敌人的“增强级别”
主角经验达到800万后，每增加50万经验，敌人继续提升1个“增强级别”，直到1800万经验达到最高的“增强级别”40级。"
@66 = "难度一：每个“增强级别”敌人增加10%生命值、1%所有伤害；每4个“增强级别”敌人增加1点魔法抗力；每7个“增强级别”敌人防御和命中+1有利；每10个“增强级别”敌人所有豁免+1有利。
例：主角800万经验时，敌人增加200%生命值、20%所有伤害、5%魔法抗力，防御和命中+2有利，豁免+2有利。"
@67 = "难度二：每个“增强级别”敌人增加20%生命值、2%所有伤害；每2个“增强级别”敌人增加1点魔法抗力；每5个“增强级别”敌人防御和命中+1有利；每8个“增强级别”敌人所有豁免+1有利。
例：主角800万经验时，敌人增加400%生命值、40%所有伤害、10%魔法抗力，防御和命中+4有利，豁免+2有利。"
@68 = "难度三：每个“增强级别”敌人增加50%生命值、5%所有伤害；每1个“增强级别”敌人增加1点魔法抗力；每3个“增强级别”敌人防御和命中+1有利；每5个“增强级别”敌人所有豁免+1有利。
例：主角800万经验时，敌人增加1000%生命值、100%所有伤害、20%魔法抗力，防御和命中+6有利，豁免+4有利。"
@69 = "敌人在战斗中根据设置获得临时增强，持续时间为5分钟，过期后会再次进行强化。"

