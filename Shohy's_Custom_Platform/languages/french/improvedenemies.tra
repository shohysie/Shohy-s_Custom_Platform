@61 = "Ennemis renforcés (les statistiques des ennemis augmentent avec l'XP du protagoniste)"
@62 = "XP de kill accordée au dernier attaquant"

@65 = "Le 'Niveau de renforcement' des ennemis = (Niveau d'un guerrier pur avec l'XP du protagoniste) / 2. Après que le protagoniste a accumulé 8 millions d'XP, +1 'Niveau de renforcement' par tranche de 500k XP, jusqu'à un maximum de niveau 40 à 18 millions d'XP."
@66 = "Facile : pour chaque 'Niveau de renforcement', l'ennemi gagne 10% de santé et 1% de tous les dégâts ; pour 4 niveaux, +1 résistance à la magie ; pour 7 niveaux, +1 bonus à la CA et au THAC0 ; pour 10 niveaux, +1 bonus à tous les jets de sauvegarde. Exemple : À 8M XP, les ennemis gagnent +200% santé, +20% dégâts, +5% résistance magique, +2 CA/THAC0, +2 sauvegardes."
@67 = "Normal : pour chaque 'Niveau de renforcement', l'ennemi gagne 20% santé et 2% dégâts ; pour 2 niveaux, +1 résistance magique ; pour 5 niveaux, +1 CA/THAC0 ; pour 8 niveaux, +1 sauvegarde. Exemple : À 8M XP, +400% santé, +40% dégâts, +10% résistance magique, +4 CA/THAC0, +2 sauvegardes."
@68 = "Difficile : pour chaque 'Niveau de renforcement', l'ennemi gagne 50% santé et 5% dégâts ; pour chaque niveau, +1 résistance magique ; pour 3 niveaux, +1 CA/THAC0 ; pour 5 niveaux, +1 sauvegarde. Exemple : À 8M XP, +1000% santé, +100% dégâts, +20% résistance magique, +6 CA/THAC0, +4 sauvegardes."
@69 = "Les ennemis obtiennent des renforcements temporaires en combat selon les réglages, durant 10 minutes. Après expiration, le renforcement est réappliqué."

@70 = "Paramètres du module : Ennemis renforcés (augmentation des statistiques)"
@71 = "Paramètres du module : Augmentation des statistiques des ennemis (dure 10 minutes, se réapplique après expiration)"
@72 = "Désactiver, les ennemis n'augmentent pas leurs statistiques"
@73 = "Facile, les ennemis gagnent une légère augmentation"
@74 = "Normal, les ennemis gagnent une augmentation modérée"
@75 = "Difficile, les ennemis gagnent une forte augmentation"
@76 = "Conserver le réglage actuel (pas d'augmentation) et revenir au menu précédent"
@77 = "Conserver le réglage actuel (Facile) et revenir au menu précédent"
@78 = "Conserver le réglage actuel (Normal) et revenir au menu précédent"
@79 = "Conserver le réglage actuel (Difficile) et revenir au menu précédent"

