@201 = "Maintien de la difficulté (les ennemis montent de niveau avec le protagoniste et gagnent des compétences)"

@206 = "Malédiction"
@207 = "Chant du barde"
@208 = "Chant puissant"
@209 = "Perturbation d'incantation"

@210 = "Conserver le réglage actuel (Pas d'élévation de niveau) et revenir au menu précédent"
@211 = "Conserver le réglage actuel (Élévation de niveau) et revenir au menu précédent"
@212 = "Conserver le réglage actuel (Pas de compétences normales) et revenir au menu précédent"
@213 = "Conserver le réglage actuel (20%-50% de chance d'utiliser compétences normales) et revenir"
@214 = "Conserver le réglage actuel (40%-100% de chance) et revenir"
@215 = "Conserver le réglage actuel (Pas de compétences de haut niveau) et revenir"
@216 = "Conserver le réglage actuel (1-3 compétences de haut niveau à la suite) et revenir"
@217 = "Conserver le réglage actuel (environ 4 compétences de haut niveau) et revenir"
@218 = "Conserver le réglage actuel (Affecté par la race) et revenir"
@219 = "Conserver le réglage actuel (Ignore la race) et revenir"

@221 = "Paramètres du module : Maintien de la difficulté (ennemis montent de niveau et gagnent compétences)"
@222 = "Configurer la croissance des ennemis de bas niveau"
@223 = "Les ennemis de bas niveau ne montent pas de niveau"
@224 = "Les ennemis de bas niveau montent de niveau pour s'approcher du protagoniste, et leurs statistiques liées au niveau augmentent aussi (effet permanent : même désactivé, les ennemis déjà améliorés ne régressent pas)"
@225 = "Configurer l'utilisation de compétences normales par les ennemis (ex. Enrager, Tir ajusté, Arme empoisonnée)"
@226 = "Configurer l'utilisation de compétences normales"
@227 = "Les ennemis n'utilisent pas de compétences normales supplémentaires"
@228 = "Un ennemi a 20%-50% de chance d'utiliser une compétence normale, probabilité croissante avec son niveau"
@229 = "Un ennemi a 40%-100% de chance"
@230 = "Configurer l'utilisation de compétences de haut niveau par les ennemis (ex. Robustesse, Grand cyclone, Assassinat)"
@231 = "Configurer l'utilisation de compétences de haut niveau"
@232 = "Les ennemis n'utilisent pas de compétences de haut niveau supplémentaires"
@233 = "Un ennemi enchaîne 1-3 compétences (normales ou de haut niveau) sur une courte période"
@234 = "Un ennemi enchaîne environ 4 compétences"
@235 = "Définir si l'utilisation des compétences par les ennemis est affectée par la race"
@236 = "Races civilisées : normales ; races barbares : probabilité divisée par deux ; races non-sapientes : presque pas de compétences"
@237 = "Toutes les races utilisent normalement leurs compétences"

@241 = "Lire la description détaillée de 'Les ennemis montent de niveau avec le protagoniste'"
@242 = "Lire la description détaillée de 'Les ennemis peuvent utiliser des compétences'"

@261 = "Les ennemis de bas niveau augmentent leur niveau en fonction de l'XP et du niveau du protagoniste. Les PV, THAC0, sauvegardes et attaques par round augmentent aussi avec le niveau. Les statistiques non liées au niveau (CA, dégâts, etc.) ne changent pas."
@262 = "En raison de problèmes avec l'opcode Level Change du moteur Infinity, le niveau réel des ennemis n'augmente pas forcément, mais les statistiques associées augmentent bien."
@266 = "Les ennemis lancent automatiquement diverses compétences en début de combat. Vous pouvez paramétrer la probabilité et l'influence de la race. Si le combat n'est pas terminé en 6 rounds, les ennemis peuvent relancer leurs compétences."
@267 = "Si l'IA d'origine des ennemis utilise déjà des compétences, cela peut entraîner des doublons, mais les effets des mêmes compétences ne se cumulent pas. Le Rage du berserker et celui du barbare peuvent apparaître ensemble sans se cumuler."
