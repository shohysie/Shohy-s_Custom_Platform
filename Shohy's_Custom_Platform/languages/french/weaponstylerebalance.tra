@143 = "Activer toutes les fonctions, uniquement pour l'équipe du joueur"
@144 = "Désactiver les effets détaillés des armes, ne garder que le Rééquilibrage, effectif pour ennemis et alliés"
@145 = "Désactiver les effets détaillés, ne garder que le Rééquilibrage, uniquement pour l'équipe du joueur"
