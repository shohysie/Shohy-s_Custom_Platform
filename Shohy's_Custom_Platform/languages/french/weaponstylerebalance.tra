@101 = "Rééquilibrage des styles d'armes et ajustements détaillés par type d'arme"
@102 = "Davantage de slots de maîtrise peuvent être investis dans tous les styles d'armes"
@103 = "(Recommandé) N'augmente pas réellement la limite d'étoiles, mais réduit automatiquement d'une étoile lorsqu'on atteint 2 ou 3 étoiles en échange de bonus supplémentaires (réglable manuellement). Aucun problème de compatibilité."
@104 = "Augmente réellement la limite d'étoiles, mais incompatible avec d'autres MODs modifiant les règles des styles d'armes. Doit être installé après tous les MODs de kits"
@105 = "Nécessite d'abord d'installer 'Rééquilibrage des styles d'armes et ajustements détaillés par type d'arme'"

@111 = "Rééquilibrage des styles d'armes : Style à deux armes passe de 3 étoiles à 2, avec compensation numérique déjà donnée. Si les 3 étoiles sont à nouveau atteintes, la réduction se reproduira. Peut être désactivé via la capacité innée du protagoniste."
@112 = "Style à deux armes passe de 2 étoiles à 1, compensation donnée. Peut ensuite être normalement augmenté à 2 étoiles."
@113 = "Style à deux armes passe de 3 étoiles à 2, puis peut être normalement augmenté à 3 étoiles et supprime la pénalité d'attaques par round."
@114 = "Style à deux mains passe de 2 étoiles à 1, compensation donnée. Peut ensuite être augmenté à 2 étoiles."
@115 = "Style épée et bouclier passe de 2 étoiles à 1, compensation donnée. Peut ensuite être augmenté à 2 étoiles."
@116 = "Style à une main passe de 2 étoiles à 1, compensation donnée. Peut ensuite être augmenté à 2 étoiles."

@117 = "Rééquilibrage : Le étoile de compétence déduit pour le style à deux armes a été remboursé."
@118 = "Rééquilibrage : Le étoile de compétence déduit pour le style à deux mains a été remboursé."
@119 = "Rééquilibrage : Le étoile de compétence déduit pour le style épée et bouclier a été remboursé."
@120 = "Rééquilibrage : Le étoile de compétence déduit pour le style à une main a été remboursé."

